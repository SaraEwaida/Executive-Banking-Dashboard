            "name": "Date",
            "mode": "import",
            "source": {
              "expression": "ADDCOLUMNS ( CALENDAR ( DATE(2015,1,1), DATE(2026,12,31) ), \"Year\", YEAR([Date]), \"MonthNo\", MONTH([Date]), \"Month\", FORMAT([Date],\"MMM\"), \"YearMonth\", FORMAT([Date],\"YYYY-MM\"), \"MonthYear\", FORMAT([Date],\"MMM YYYY\"), \"Quarter\", \"Q\" & FORMAT([Date],\"Q\") )",
              "type": "calculated"
            }
          }
        ]
