            "formatString": "\\$#,0",
            "lineageTag": "46adc617-36ff-4c1f-b54d-e87dc25f1ee8"
          },
          {
            "name": "Total Fees Collected",
            "displayFolder": "07 Bonus - Cards & Fees",
            "expression": "CALCULATE ( SUM ( Fees[Amount] ), Fees[Status] = \"PAID\" )",
            "formatString": "\\$#,0",
            "lineageTag": "31890466-0002-446b-981f-6de6630a6b4b"
          }
        ],
