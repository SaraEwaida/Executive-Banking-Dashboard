        "lineageTag": "a33a7bcc-f44d-47ce-a4e1-11959a98b495",
        "measures": [
          {
            "name": "Total Customers",
            "displayFolder": "01 Core KPIs",
            "expression": "DISTINCTCOUNT ( Customers[CustomerID] )",
            "formatString": "#,0",
            "lineageTag": "91a08682-d54d-4871-b49d-9ff659f4baa2"
          },
          {
            "name": "Total Accounts",
            "displayFolder": "01 Core KPIs",
            "expression": "COUNTROWS ( Accounts )",
            "formatString": "#,0",
            "lineageTag": "720ba4c8-b09e-4cbc-a047-4671344ec8d4"
          },
          {
            "name": "Total Balance",
            "displayFolder": "01 Core KPIs",
            "expression": "SUM ( Accounts[Balance] )",
            "formatString": "\\$#,0",
            "lineageTag": "eadb9230-215f-4cb4-becc-3bdfcc50b5ce"
          },
          {
            "name": "Total Transactions",
            "displayFolder": "01 Core KPIs",
            "expression": "COUNTROWS ( Transactions )",
            "formatString": "#,0",
            "lineageTag": "0f169f89-ad1a-463d-87fa-5662fa385ee8"
          },
          {
            "name": "Total Loans",
            "displayFolder": "01 Core KPIs",
            "expression": "COUNTROWS ( Loans )",
            "formatString": "#,0",
            "lineageTag": "d3ed6e7b-97ac-4964-8bbe-1b475b9beed2"
          },
          {
            "name": "Total Branches",
            "displayFolder": "01 Core KPIs",
            "expression": "DISTINCTCOUNT ( Branches[BranchID] )",
            "formatString": "#,0",
            "lineageTag": "f2d92b63-f0b0-41cf-9edf-262286b53660"
          },
          {
            "name": "Active Accounts",
            "displayFolder": "02 Accounts",
            "expression": "CALCULATE ( COUNTROWS ( Accounts ), Accounts[Status] = \"ACTIVE\" )",
            "formatString": "#,0",
            "lineageTag": "9e48d1f0-dfce-456d-b5cb-debde9046c4f"
          },
          {
            "name": "Closed Accounts",
            "displayFolder": "02 Accounts",
            "expression": "CALCULATE ( COUNTROWS ( Accounts ), Accounts[Status] = \"CLOSED\" )",
            "formatString": "#,0",
            "lineageTag": "6e721d1e-5102-48e8-becb-12f73552a028"
          },
          {
            "name": "Average Balance",
            "displayFolder": "02 Accounts",
            "expression": "AVERAGE ( Accounts[Balance] )",
            "formatString": "\\$#,0",
            "lineageTag": "9cb1e291-2fa7-47c4-92bc-c0ada9c2a4a8"
          },
          {
            "name": "Active Account %",
            "displayFolder": "02 Accounts",
            "expression": "DIVIDE ( [Active Accounts], [Total Accounts] )",
            "formatString": "0.0%",
            "lineageTag": "7893404c-92b7-40d1-b4ef-2a467d2c633f"
          },
          {
            "name": "Transaction Count",
            "displayFolder": "03 Transactions",
            "expression": "COUNTROWS ( Transactions )",
            "formatString": "#,0",
            "lineageTag": "e7692c47-1ea8-4c80-b8e6-eabaaa156ef7"
          },
          {
            "name": "Deposit Amount",
            "displayFolder": "03 Transactions",
            "expression": "CALCULATE ( SUM ( Transactions[Amount] ), Transactions[TransType] = \"DEPOSIT\" )",
            "formatString": "\\$#,0",
            "lineageTag": "19bc4b6b-246c-499a-98fa-dfe058209503"
          },
          {
            "name": "Withdrawal Amount",
            "displayFolder": "03 Transactions",
            "expression": "CALCULATE ( SUM ( Transactions[Amount] ), Transactions[TransType] = \"WITHDRAWAL\" )",
            "formatString": "\\$#,0",
            "lineageTag": "c47cfa2c-3f31-4704-b834-cfbd6c5ec8f3"
          },
          {
            "name": "Transfer Amount",
            "displayFolder": "03 Transactions",
            "expression": "CALCULATE ( SUM ( Transactions[Amount] ), Transactions[TransType] = \"TRANSFER\" )",
            "formatString": "\\$#,0",
            "lineageTag": "a07adbf1-9fe7-45e3-9f2c-3bcf8d9a853a"
          },
          {
            "name": "Total Transaction Amount",
            "displayFolder": "03 Transactions",
            "expression": "SUM ( Transactions[Amount] )",
            "formatString": "\\$#,0",
            "lineageTag": "9530a889-c706-4dd2-81a8-04a1f1b577d5"
          },
          {
            "name": "Average Transaction Amount",
            "displayFolder": "03 Transactions",
            "expression": "AVERAGE ( Transactions[Amount] )",
            "formatString": "\\$#,0",
            "lineageTag": "1fbf6ebe-deee-40e4-99c0-eb647fc16017"
          },
          {
            "name": "Net Cash Flow",
            "displayFolder": "03 Transactions",
            "expression": "[Deposit Amount] - [Withdrawal Amount]",
            "formatString": "\\$#,0",
            "lineageTag": "b4523269-a9c6-41ba-a5e9-269b9f98e58b"
          },
          {
            "name": "Total Loan Amount",
            "displayFolder": "04 Loans",
            "expression": "SUM ( Loans[Amount] )",
            "formatString": "\\$#,0",
            "lineageTag": "43cd5fd1-f201-4be2-828f-26bb12952966"
          },
          {
            "name": "Active Loans",
            "displayFolder": "04 Loans",
            "expression": "CALCULATE ( COUNTROWS ( Loans ), Loans[Status] = \"ACTIVE\" )",
            "formatString": "#,0",
            "lineageTag": "5375dd83-b3a2-4b1a-a147-d6e4f6ff4cd2"
          },
          {
            "name": "Paid Loans",
            "displayFolder": "04 Loans",
            "expression": "CALCULATE ( COUNTROWS ( Loans ), Loans[Status] = \"PAID\" )",
            "formatString": "#,0",
            "lineageTag": "1447f18b-27f2-4d20-8888-d70bb822acd7"
          },
          {
            "name": "Outstanding Loan Amount",
            "displayFolder": "04 Loans",
            "expression": "CALCULATE ( SUM ( Loans[Amount] ), Loans[Status] = \"ACTIVE\" )",
            "formatString": "\\$#,0",
            "lineageTag": "5656e37f-35da-4db6-b806-33f9aa255c3e"
          },
          {
            "name": "Average Interest Rate",
            "displayFolder": "04 Loans",
            "expression": "AVERAGE ( Loans[InterestRate] )",
            "formatString": "0.00\\%",
            "lineageTag": "831c97bd-1818-4315-9524-777577627d73"
          },
          {
            "name": "Average Loan Size",
            "displayFolder": "04 Loans",
            "expression": "AVERAGE ( Loans[Amount] )",
            "formatString": "\\$#,0",
            "lineageTag": "66d1f6f3-08db-4136-aa3a-77e976b48aff"
          },
          {
            "name": "New Customers",
            "displayFolder": "05 Time Intelligence",
            "expression": "CALCULATE ( COUNTROWS ( Customers ), USERELATIONSHIP ( 'Date'[Date], Customers[JoinDate] ) )",
            "formatString": "#,0",
            "lineageTag": "fc591c70-1c31-4f11-b1a3-e4663d66b538"
          },
          {
            "name": "Running Total Balance",
            "displayFolder": "05 Time Intelligence",
            "expression": "CALCULATE ( [Total Balance], FILTER ( ALL ( 'Date'[Date] ), 'Date'[Date] <= MAX ( 'Date'[Date] ) ), USERELATIONSHIP ( 'Date'[Date], Accounts[OpenDate] ) )",
            "formatString": "\\$#,0",
            "lineageTag": "f6f48124-835d-4261-a31f-064a751aeca2"
          },
          {
            "name": "YTD Transactions",
            "displayFolder": "05 Time Intelligence",
            "expression": "TOTALYTD ( [Transaction Count], 'Date'[Date] )",
            "formatString": "#,0",
            "lineageTag": "f2dd177e-a669-43b0-a862-b0295fd1c042"
          },
          {
            "name": "YTD Transaction Amount",
            "displayFolder": "05 Time Intelligence",
            "expression": "TOTALYTD ( [Total Transaction Amount], 'Date'[Date] )",
            "formatString": "\\$#,0",
            "lineageTag": "4e512188-34c3-4afb-be7d-fa046ff25338"
          },
          {
            "name": "Prev Month Transactions",
            "displayFolder": "05 Time Intelligence",
            "expression": "CALCULATE ( [Transaction Count], PREVIOUSMONTH ( 'Date'[Date] ) )",
            "formatString": "#,0",
            "lineageTag": "de531942-42ee-442c-b6f2-2a1b743a9395"
          },
          {
            "name": "Monthly Growth %",
            "displayFolder": "05 Time Intelligence",
            "expression": "VAR Prev = [Prev Month Transactions] RETURN DIVIDE ( [Transaction Count] - Prev, Prev )",
            "formatString": "0.0%",
            "lineageTag": "f422ce54-d0dd-41da-9c97-5786df8b40b7"
          },
          {
            "name": "Rank Branch",
            "displayFolder": "06 Ranking & Branch",
            "expression": "RANKX ( ALL ( Branches[BranchName] ), [Total Balance], , DESC, DENSE )",
            "formatString": "#,0",
            "lineageTag": "b2877d42-787f-48f4-956b-04cc721f239c"
          },
          {
            "name": "Total Deposits",
            "displayFolder": "06 Ranking & Branch",
            "expression": "[Deposit Amount]",
            "formatString": "\\$#,0",
            "lineageTag": "aecc43ad-a112-4c48-a765-662be8df557a"
          },
          {
            "name": "Total Employees",
            "displayFolder": "06 Ranking & Branch",
            "expression": "COUNTROWS ( Employees )",
            "formatString": "#,0",
            "lineageTag": "9544029a-90ba-4b2a-81ee-42c68017bdf3"
          },
          {
            "name": "Total Cards",
            "displayFolder": "07 Bonus - Cards & Fees",
            "expression": "COUNTROWS ( Cards )",
            "formatString": "#,0",
            "lineageTag": "b12cf226-0248-430a-8a66-d6d8cd12803d"
          },
          {
            "name": "Active Cards",
            "displayFolder": "07 Bonus - Cards & Fees",
            "expression": "CALCULATE ( COUNTROWS ( Cards ), Cards[Status] = \"ACTIVE\" )",
            "formatString": "#,0",
            "lineageTag": "4dec7205-a317-4ba0-9603-cd804618ddc4"
          },
          {
            "name": "Total Credit Limit",
            "displayFolder": "07 Bonus - Cards & Fees",
            "expression": "SUM ( Cards[CreditLimit] )",
            "formatString": "\\$#,0",
            "lineageTag": "32d00c94-1352-4f31-ba40-1ba26ef78e5c"
          },
          {
            "name": "Total Fees",
            "displayFolder": "07 Bonus - Cards & Fees",
